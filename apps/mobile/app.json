{
  "expo": {
    "name": "Converse",
    "slug": "converse-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14171A"
    },
    "ios": {
      "bundleIdentifier": "com.converse.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Precisamos da câmera para ler o QR Code do Converse Web e tirar fotos."
      }
    },
    "android": {
      "package": "com.converse.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14171A"
      },
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear o QR Code do Converse Web."
        }
      ]
    ]
  }
}
