# Copie para .env e preencha com valores reais antes do deploy
NODE_ENV=production
PORT=3001

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-de-64-caracteres

# Domínio(s) autorizados para o Converse Web (separados por vírgula se múltiplos)
CORS_ORIGIN=https://converse.seu-dominio.com

# Defina true apenas se quiser popular usuários de demonstração no primeiro boot
SEED_DEMO=false

# Mobile (usado ao compilar o app para produção)
EXPO_PUBLIC_API_URL=https://api.converse.seu-dominio.com

# Envio de SMS para recuperação de senha (opcional: configure Twilio ou Webhook HTTP)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+5511999999999
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
